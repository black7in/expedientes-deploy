# Copiar como .env y completar los valores
# cp .env.example .env

# ── Laravel ───────────────────────────────────────────────────────────────────
# Generar con: php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=base64:CAMBIA_ESTO
APP_URL=http://TU_IP_O_DOMINIO
APP_PORT=80

# ── Base de datos ─────────────────────────────────────────────────────────────
DB_DATABASE=expedientes_juridicos
DB_USERNAME=laravel
DB_PASSWORD=CAMBIA_ESTO

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Opción A — Anthropic nativo (producción recomendada):
#   ANTHROPIC_API_KEY=sk-ant-...
#   LLM_BASE_URL=           (vacío)
#   LLM_MODEL=claude-sonnet-4-6
#
# Opción B — OpenCode Go u otro provider compatible con SDK Anthropic:
#   ANTHROPIC_API_KEY=<key del provider>
#   LLM_BASE_URL=https://opencode.ai/zen/go   (sin /v1 — el SDK lo agrega)
#   LLM_MODEL=kimi-k2.6
ANTHROPIC_API_KEY=CAMBIA_ESTO
LLM_BASE_URL=
LLM_MODEL=claude-sonnet-4-6
