@startuml Arquitectura de Despliegue
title Sistema de Gestión de Expedientes Jurídicos\nRosales y Asociados — Arquitectura de Despliegue

skinparam nodeBorderColor #2c3e50
skinparam nodeBackgroundColor #ecf0f1
skinparam artifactBorderColor #2980b9
skinparam artifactBackgroundColor #d6eaf8
skinparam databaseBorderColor #8e44ad
skinparam databaseBackgroundColor #e8daef
skinparam componentBorderColor #27ae60
skinparam componentBackgroundColor #d5f5e3
skinparam cloudBorderColor #e67e22
skinparam cloudBackgroundColor #fdebd0
skinparam shadowing false
skinparam linetype ortho

' ══════════════════════════════════════════════════
'  CLIENTE
' ══════════════════════════════════════════════════
node "Navegador Web\n(Abogado / Administrador)" as browser {
    artifact "Livewire SPA\n(HTML + Alpine.js)" as spa
}

' ══════════════════════════════════════════════════
'  VPS GCP  (34.27.64.244)
' ══════════════════════════════════════════════════
node "VPS — Google Cloud Platform\nDebian · 4 GB RAM · Docker 24" as vps {

    node "Docker Network: juridico_net" as docker_net {

        node "expedientes_nginx\n(nginx:alpine)" as nginx {
            artifact "Reverse Proxy\n+ Assets estáticos" as proxy
        }

        node "expedientes_app\n(PHP 8.3-FPM)" as app {
            artifact "Laravel 13\n+ Livewire v3" as laravel
        }

        node "expedientes_queue\n(PHP 8.3-FPM)" as queue {
            artifact "Queue Worker\nphp artisan queue:work" as worker
        }

        node "expedientes_ai\n(Python 3.12)" as ai_container {
            artifact "FastAPI\n(NLP · RAG · Embeddings)" as fastapi
            artifact "multilingual-e5-large\n(CPU · 1024 dims)" as e5
        }

        database "expedientes_postgres\n(pgvector:pg16)" as postgres {
            artifact "expedientes_juridicos" as db
        }

        database "expedientes_redis\n(redis:7-alpine)" as redis {
            artifact "Colas · Caché · Sesiones" as cache
        }
    }

    ' Volúmenes Docker
    storage "Volúmenes Docker" as volumes {
        artifact "postgres_data" as vol_pg
        artifact "storage_data\n(PDF · DOCX subidos)" as vol_storage
        artifact "public_data\n(CSS · JS compilado)" as vol_public
        artifact "huggingface_cache\n(~1.2 GB)" as vol_hf
    }
}

' ══════════════════════════════════════════════════
'  SERVICIOS EXTERNOS
' ══════════════════════════════════════════════════
cloud "Proveedor LLM" as llm_cloud {
    artifact "Anthropic API\nclaude-sonnet-4-6\n(producción)" as anthropic
    artifact "OpenCode Go\nminimax-m2.7 · kimi-k2.6\n(desarrollo)" as opencode
}

cloud "GitHub" as github {
    artifact "black7in/expedientes-app\n(branch: develop)" as repo_app
    artifact "black7in/expedientes-ai\n(branch: master)" as repo_ai
    artifact "black7in/expedientes-deploy\n(branch: master)" as repo_deploy
}

' ══════════════════════════════════════════════════
'  COMUNICACIONES
' ══════════════════════════════════════════════════

' Cliente → Nginx
browser -down-> nginx : "HTTPS :80\n(HTTP en dev)"

' Nginx → App
nginx -down-> app : "FastCGI\n(PHP-FPM)"

' App → DB / Cache
app -down-> postgres  : "PostgreSQL\n:5432"
app -down-> redis     : "Redis\n:6379"
app -right-> ai_container : "HTTP :8000\n(AI_SERVICE_URL)"

' Queue → DB / Cache / AI
queue -down-> postgres : "PostgreSQL"
queue -down-> redis    : "Redis (jobs)"
queue -right-> ai_container : "HTTP :8000\n(indexar docs)"

' AI → DB
ai_container -down-> postgres : "PostgreSQL+asyncpg\n:5432 (pgvector)"

' AI → LLM externo
ai_container -right-> llm_cloud : "HTTPS\n(classify · parse · generate)"

' Volúmenes
app ..> vol_storage  : mount
app ..> vol_public   : mount
nginx ..> vol_public : mount (ro)
queue ..> vol_storage : mount
ai_container ..> vol_storage : mount (ro)
ai_container ..> vol_hf      : mount
postgres ..> vol_pg          : mount

' Deploy
github -up-> vps : "bash update.sh\n(git pull + rebuild)"

' ══════════════════════════════════════════════════
'  LEYENDA
' ══════════════════════════════════════════════════
legend right
  |= Símbolo |= Significado |
  | node      | Contenedor Docker o servidor |
  | artifact  | Aplicación o componente |
  | database  | Base de datos |
  | storage   | Volumen persistente |
  | cloud     | Servicio externo |
  | --->      | Comunicación de red |
  | ...>      | Montaje de volumen |
endlegend

@enduml
