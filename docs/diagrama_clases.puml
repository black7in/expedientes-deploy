@startuml Sistema de Expedientes Juridicos
title Sistema de Gestión de Expedientes Jurídicos\nRosales y Asociados — Diagrama de Clases

skinparam classAttributeIconSize 0
skinparam classBorderColor #2c3e50
skinparam classBackgroundColor #ecf0f1
skinparam packageBorderColor #7f8c8d
skinparam packageBackgroundColor #f9f9f9
skinparam arrowColor #2c3e50
skinparam shadowing false
skinparam linetype ortho

' ══════════════════════════════════════════════════
'  PAQUETE: Usuarios y Autenticación
' ══════════════════════════════════════════════════
package "Usuarios y Autenticación" {

    class User {
        +UUID id
        +String nombre
        +String correo
        +String password
        +Enum rol
        +Boolean activo
        +Timestamp created_at
        +Timestamp updated_at
        --
        +isAdmin() : bool
        +isAbogado() : bool
        +isPasante() : bool
    }

    note right of User
        rol: administrador |
        abogado | pasante
    end note
}

' ══════════════════════════════════════════════════
'  PAQUETE: Gestión de Expedientes
' ══════════════════════════════════════════════════
package "Gestión de Expedientes" {

    class Expediente {
        +UUID id
        +String numero_expediente <<nullable>>
        +UUID juzgado_id
        +UUID tipo_proceso_id
        +UUID abogado_id
        +Enum estado
        +Datetime fecha_inicio
        +Timestamp created_at
        +Timestamp updated_at
        --
        +cliente() : Parte
    }

    class Parte {
        +UUID id
        +UUID expediente_id
        +UUID persona_id
        +Enum rol_procesal
        +Boolean es_cliente
        +Timestamp created_at
        +Timestamp updated_at
    }

    class Persona {
        +UUID id
        +String nombre_completo
        +String ci_nit
        +Enum tipo_persona
        +String telefono <<nullable>>
        +String correo <<nullable>>
        +String direccion <<nullable>>
        +Timestamp created_at
        +Timestamp updated_at
    }

    class Juzgado {
        +UUID id
        +String nombre
        +String ciudad
        +Boolean activo
        +Timestamp created_at
        +Timestamp updated_at
    }

    class TipoProceso {
        +UUID id
        +String nombre
        +String area_derecho
        +Boolean activo
        +Timestamp created_at
        +Timestamp updated_at
    }

    class EtapaTipoProceso {
        +UUID id
        +UUID tipo_proceso_id
        +String nombre
        +Integer orden
        +Integer dias_plazo
        +Timestamp created_at
        +Timestamp updated_at
    }

    class Actuacion {
        +UUID id
        +UUID expediente_id
        +UUID usuario_id
        +String descripcion
        +Datetime fecha
        +String tipo_actuacion
        +Timestamp created_at
        --
        <<inmutable>>
        +{static} boot() : void
    }

    note bottom of Actuacion
        Inmutable: no permite
        update ni delete
    end note
}

' ══════════════════════════════════════════════════
'  PAQUETE: Gestión de Documentos
' ══════════════════════════════════════════════════
package "Gestión de Documentos" {

    class Documento {
        +UUID id
        +UUID expediente_id <<nullable>>
        +UUID usuario_id
        +String nombre_archivo
        +String formato
        +String tipo_documento <<nullable>>
        +String subtipo <<nullable>>
        +String estructura <<nullable>>
        +Enum estado_extraccion
        +JSON texto_extraido <<nullable>>
        +Boolean indexado
        +String content_hash <<nullable>>
        +JSON metadata <<nullable>>
        +Timestamp created_at
        +Timestamp updated_at
        --
        +isPendiente() : bool
        +isProcesado() : bool
    }

    note right of Documento
        estado_extraccion:
        pendiente | procesado | error
        --
        texto_extraido: { texto_completo,
        paginas, paginas_detalle, metadata }
    end note
}

' ══════════════════════════════════════════════════
'  PAQUETE: Base de Conocimiento (pgvector)
' ══════════════════════════════════════════════════
package "Base de Conocimiento (pgvector)" {

    class DocChunk {
        +UUID id
        +UUID documento_id
        +UUID expediente_id <<nullable>>
        +String tipo_doc
        +String subtipo <<nullable>>
        +String seccion
        +String chunk_texto
        +Integer chunk_index
        +Integer sub_chunk_index
        +String embedding_model
        +Vector(1024) embedding
        +Timestamp created_at
    }

    class LeyesChunk {
        +UUID id
        +String ley
        +String numero_articulo
        +String titulo_articulo <<nullable>>
        +String materia
        +String chunk_texto
        +Vector(1024) embedding
        +Timestamp created_at
    }

    class JurisprudenciaChunk {
        +UUID id
        +String numero_auto
        +Date fecha_resolucion <<nullable>>
        +String materia
        +String sala <<nullable>>
        +String chunk_texto
        +Vector(1024) embedding
        +Timestamp created_at
    }

    note bottom of LeyesChunk
        Indexados:
        Código Civil (1624 chunks)
        Código Procesal Civil (674 chunks)
    end note
}

' ══════════════════════════════════════════════════
'  PAQUETE: Generación RAG
' ══════════════════════════════════════════════════
package "Generación RAG" {

    class Plantilla {
        +UUID id
        +String tipo_documento
        +String subtipo
        +String nombre
        +String descripcion <<nullable>>
        +JSON secciones
        +String version
        +Boolean activa
        +Timestamp created_at
        +Timestamp updated_at
    }

    note right of Plantilla
        secciones: array de
        { id, nombre, orden,
        obligatoria, instrucciones,
        retrieval, salida }
    end note

    class Generacion {
        +UUID id
        +UUID usuario_id
        +UUID expediente_id <<nullable>>
        +String tipo_documento
        +String subtipo
        +UUID plantilla_id
        +Enum formato_salida
        +JSON input_formulario
        +Enum estado
        +Boolean cancelada
        +Text contenido_actual <<nullable>>
        +String llm_provider <<nullable>>
        +String llm_model <<nullable>>
        +Integer tokens_input
        +Integer tokens_output
        +Timestamp created_at
        +Timestamp updated_at
    }

    note right of Generacion
        formato_salida: estructurado | corrido
        estado: generando | completado |
        error | cancelada | editado
    end note

    class GeneracionSeccion {
        +UUID id
        +UUID generacion_id
        +String seccion_id
        +Integer orden
        +Text contenido_generado
        +Text contenido_editado <<nullable>>
        +JSON chunks_usados
        +Text prompt_usado <<nullable>>
        +Integer tokens_input
        +Integer tokens_output
        +Integer regenerada_count
        +Timestamp created_at
        +Timestamp updated_at
    }
}

' ══════════════════════════════════════════════════
'  RELACIONES
' ══════════════════════════════════════════════════

' Usuarios
User "1" --> "0..*" Expediente       : asignado a (abogado)
User "1" --> "0..*" Actuacion        : registra
User "1" --> "0..*" Documento        : sube
User "1" --> "0..*" Generacion       : genera

' Expediente
Expediente "0..*" --> "1"   Juzgado          : radicado en
Expediente "0..*" --> "1"   TipoProceso      : sigue
Expediente "1"    --> "0..*" Parte           : tiene partes
Expediente "1"    --> "0..*" Actuacion       : registra
Expediente "1"    --> "0..*" Documento       : contiene
Expediente "1"    --> "0..*" Generacion      : origina <<opcional>>

' Partes
Parte "0..*" --> "1" Persona : identifica

' Tipo proceso
TipoProceso "1" --> "0..*" EtapaTipoProceso : define etapas

' Documentos → chunks
Documento "1" --> "0..*" DocChunk : indexado en

' Generación
Plantilla      "1"    --> "0..*" Generacion        : usada por
Generacion     "1"    --> "1..*" GeneracionSeccion : compuesta de
GeneracionSeccion "0..*" ..> DocChunk             : recupera (RAG)
GeneracionSeccion "0..*" ..> LeyesChunk           : recupera (RAG)
GeneracionSeccion "0..*" ..> JurisprudenciaChunk  : recupera (RAG)

@enduml
